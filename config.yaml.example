# Copie para config.yaml e ajuste. config.yaml nunca é versionado.

autonomia:
  nivel: 2  # 0=só responde 1=sugere 2=executa LOW no workspace 3=workflows aprovados 4=tarefas longas 5=alta autonomia

provedor:
  llm_padrao: claude_cli  # claude_cli | anthropic | openai_compat | fake
  claude_cli:
    binario: claude
    timeout_segundos: 120
  anthropic:
    modelo: claude-sonnet-5
    max_tokens: 8192
  openai_compat:
    base_url: http://localhost:11434/v1  # Ollama local; para API grátis troque por Groq/Gemini/OpenRouter
    modelo: llama3
    api_key_env: ""  # nome da var de ambiente com a chave (ex: GROQ_API_KEY); vazio = sem auth (Ollama)
    timeout_segundos: 120
    max_tokens: 8192  # teto de tokens de saída; modelos com raciocínio (ex: gpt-oss no Groq) estouram o default do servidor e voltam vazios

limites:
  max_iteracoes_por_objetivo: 12
  timeout_por_passo_segundos: 60
  teto_tokens_por_objetivo: 200000
  teto_custo_usd_por_objetivo: 1.0

seguranca:
  jail_paths:
    - ~/jarvis/workspace
  # Raizes extras visiveis SO para fs.read/fs.list (leitura). fs.write nunca
  # enxerga isto -- continua confinado a jail_paths acima. Ex: ["~"] deixa o
  # agente ler qualquer arquivo em /home/igor, sem poder escrever la fora do
  # workspace.
  jail_paths_leitura: []
  allowlist_binarios:
    - ls
    - cat
    - rg
    - git
    - fd

caminhos:
  workspace: ~/jarvis/workspace
  banco_dados: ~/jarvis/dados/jarvis.db
  auditoria_jsonl: ~/jarvis/dados/auditoria.jsonl
  logs: ~/jarvis/dados/logs
  modelos_voz: ~/jarvis/dados/modelos_voz  # modelo Piper baixado automaticamente aqui no 1o uso

conhecimento:
  diretorios: []  # ex: ["~/Documentos"] — só o que estiver aqui pode ser indexado/consultado

web:
  habilitada: true  # pesquisar/web.buscar (DuckDuckGo, sem chave). Second Brain continua a fonte principal
  timeout_segundos: 15
  limite_padrao: 4

computador:
  habilitada: false  # liga as ferramentas computador.* (mouse/teclado/janelas, M9)
  # CRITICAL: clicar/digitar/tecla sempre pedem aprovacao interativa, mesmo com isso ligado.

gdap:
  habilitada: false  # liga as ferramentas gdap.* (catálogo/consulta/IA/pipelines do GDAP)
  base_url: http://127.0.0.1:8000  # onde `gdap system serve` está rodando (projeto ~/gdap)
  api_key_env: ""  # nome da var de ambiente com a API key (ex: GDAP_API_KEY); vazio = sem auth
  # gerar a chave com: gdap system key create jarvis --role engineer  (papel "analyst" NÃO
  # basta: pipelines que ingerem/publicam dataset (read.source/write.dataset) exigem a
  # permissão dataset:write, que só entra a partir de "engineer" -- achado validando isto na
  # máquina real, não só com fakes; ver docs/DECISOES.md). "engineer" também libera sql:write,
  # mas o próprio GDAP mantém isso desligado por padrão no servidor
  # (security.sql_write_enabled: false), então gdap.consultar continua só-leitura na prática.
  timeout_segundos: 30
  pipelines_permitidos: []  # só nomes aqui podem ser rodados por gdap.executar_pipeline (MEDIUM)

voz:
  habilitada: false
  stt_modelo: small  # tamanho do modelo faster-whisper: tiny|base|small|medium|large-v3
  dispositivo: auto  # só "auto" é suportado por enquanto (deixa PortAudio/PipeWire escolher)
  taxa_amostragem: 16000
  idioma: pt
  tts_voz: pt_BR-faber-medium
  duracao_captura_segundos: 6.0  # janela fixa de gravação no "jarvis voz falar" (push-to-talk)

